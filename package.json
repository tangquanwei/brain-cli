{
  "name": "@qwtang/brain-cli",
  "version": "0.1.1",
  "description": "🧠 2ndBrain CLI - 本地优先的第二大脑：Markdown + PARA + Git",
  "type": "module",
  "license": "Apache-2.0",
  "author": "tangquanwei",
  "repository": {
    "type": "git",
    "url": "https://github.com/tangquanwei/brain-cli.git"
  },
  "keywords": [
    "second-brain",
    "zettelkasten",
    "para-method",
    "markdown",
    "knowledge-management",
    "cli",
    "notes"
  ],
  "bin": {
    "brain": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm test && npm run typecheck && npm run build && node dist/cli.js links --check",
    "benchmark:links": "tsx script/benchmark-link-scan.ts 1000 && tsx script/benchmark-link-scan.ts 10000",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web-ui",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "cytoscape": "^3.34.0",
    "marked": "^18.0.9",
    "prettier": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vitest": "^3.2.7"
  }
}
