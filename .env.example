# ============================================
# 🧠 2ndBrain CLI - 环境变量配置
# ============================================
# 复制此文件为 .env 并按需修改
# cp .env.example .env
# ============================================

# 本地笔记存储目录（相对仓库根目录，或绝对路径）
NOTES_DIR=notes

# Notion integration token（将目标页面共享给该 integration）
# NOTION_TOKEN=secret_xxx

# 每次 capture/rename/move 后是否自动 git commit notes 仓库
GIT_AUTO_COMMIT=true

# 是否启用 watcher 后台守护（文件变化自动提交）
WATCH_ENABLED=true

# Git 自动推送间隔（秒，默认 900 = 15 分钟，0 = 禁用）
PUSH_INTERVAL=900

# 文件变化检测 + 自动 commit 间隔（秒，默认 30）
COMMIT_INTERVAL=30

# 多端同步：watcher 自动拉取远程更新的间隔（秒，默认 0 = 禁用）
# 冲突时本地提交会自动推送到 backup/conflict-<主机>-<时间> 分支，绝不丢数据
# PULL_INTERVAL=900

# Hexo Blog directory, relative to the workspace or absolute.
# Notes → Publish to Blog writes source/_posts; deployment remains manual.
BLOG_DIR=blog

# WebUI 监听地址（默认仅本机访问；设为 0.0.0.0 可通过异地组网/局域网访问）
# WEB_HOST=127.0.0.1

# WebUI 访问令牌（组网监听时强烈建议设置；设置后所有请求需携带 Bearer 头或 ?token= 参数）
# WEB_TOKEN=

