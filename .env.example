# ============================================
# 🧠 2ndBrain CLI - 环境变量配置
# ============================================
# 复制此文件为 .env 并按需修改
# cp .env.example .env
# ============================================

# 本地笔记存储目录（相对仓库根目录，或绝对路径）
NOTES_DIR=notes

# 每次 capture/rename/move 后是否自动 git commit notes 仓库
GIT_AUTO_COMMIT=true

# 是否启用 watcher 后台守护（文件变化自动提交）
WATCH_ENABLED=true

# Git 自动推送间隔（秒，默认 900 = 15 分钟，0 = 禁用）
PUSH_INTERVAL=900

# 文件变化检测 + 自动 commit 间隔（秒，默认 30）
COMMIT_INTERVAL=30
